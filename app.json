{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forge",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.horizonalpha.forge",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.horizonalpha.forge"
    },
    "locales": {
      "de": "./locales/de.json",
      "pt-PT": "./locales/pt-PT.json",
      "pt-BR": "./locales/pt-BR.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "de", "pt-PT", "pt-BR"],
            "android": ["en", "de", "pt-PT", "pt-BR"]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Forge uses the camera to photograph your training plan and to take your body check photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Forge lets you import a training plan from your photos and attach screenshots to support tickets.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A0A"
  }
}
