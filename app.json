{
  "expo": {
    "name": "Loqqa",
    "slug": "loqqa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loqqa",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.loqqa.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "Loqqa uses the microphone so you can say your training plan instead of typing it.",
        "NSSpeechRecognitionUsageDescription": "Loqqa turns the training plan you say into text to create your plan from it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.loqqa.mobile"
    },
    "locales": {
      "de": "./locales/de.json",
      "pt-PT": "./locales/pt-PT.json",
      "pt-BR": "./locales/pt-BR.json",
      "ko": "./locales/ko.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 64
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "de", "pt-PT", "pt-BR", "ko"],
            "android": ["en", "de", "pt-PT", "pt-BR", "ko"]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Loqqa uses the camera to photograph your training plan, to take your body check photos and your profile photo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loqqa lets you import a training plan from your photos, attach screenshots to support tickets and pick a profile photo."
        }
      ],
      "expo-document-picker",
      "expo-video",
      "expo-apple-authentication",
      "expo-speech-recognition",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.loqqa.mobile.widgets",
          "groupIdentifier": "group.app.loqqa.mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A0A"
  }
}
