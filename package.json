  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "eas build --profile production --platform ios --auto-submit",
    "env:pull": "eas env:pull --environment development --path .env.local",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts && tsc --noEmit",
    "compiler:check": "node scripts/check-react-compiler.cjs",
    "supabase:keys": "echo '[]' > supabase/signing_key.json && supabase gen signing-key --algorithm ES256 --append",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "apple:ids": "node --env-file=.env.local scripts/apple-identifiers.mjs",
    "plan:eval": "node --env-file=.env.local scripts/plan-import-eval/run.mjs",
    "plan:generate-eval": "node --env-file=.env.local scripts/plan-generate-eval/run.mjs",
    "plan:generate-compare": "node scripts/plan-generate-eval/compare.mjs",
    "powersync:up": "docker compose -f powersync/docker-compose.yml up -d",
    "powersync:down": "docker compose -f powersync/docker-compose.yml down",
    "postinstall": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts"
  },
  "private": true
