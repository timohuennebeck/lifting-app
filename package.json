  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts && tsc --noEmit",
    "supabase:keys": "echo '[]' > supabase/signing_key.json && supabase gen signing-key --algorithm ES256 --append",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "catalog:pull": "node --env-file=.env scripts/pull-exercise-catalog.mjs && prettier --write src/shared/data/exercise-catalog.json",
    "powersync:up": "docker compose -f powersync/docker-compose.yml up -d",
    "powersync:down": "docker compose -f powersync/docker-compose.yml down",
    "postinstall": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts"
  },
  "private": true
