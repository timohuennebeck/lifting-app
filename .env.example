# Loqqa Dev, the app `npm run ios` builds: copy to .env. A production build (TestFlight,
# `npm run build:ios`) never reads it (EAS leaves out gitignored files) but takes EAS's
# "production" environment, and fails on local addresses (app.config.ts).

# Local Supabase (run `npm run supabase:start` and copy the publishable key it prints).
# On a physical phone, replace 127.0.0.1 with your computer's Wi-Fi IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Local PowerSync service (run `npm run powersync:up`)
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:8080

# Optional: Google Sign-In (README, "Google Sign-In"). OAuth client IDs from Google Cloud;
# not secret. Rebuild the app after changing them.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: App Store Connect API key (Admin) for `npm run apple:ids`, which lists and deletes
# App IDs. Users and Access → Integrations → App Store Connect API → Team Keys.
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=~/Downloads/AuthKey_XXXXXXXXXX.p8

# Optional: RevenueCat's public iOS SDK key (appl_…). Without it purchases are simulated
# (development builds only). README, "Purchases".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Optional: PostHog analytics and error tracking (README, "Analytics"). The project key (phc_…)
# is public; without it nothing is tracked. EU cloud by default.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
