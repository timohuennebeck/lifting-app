# Copy to supabase/.env (gitignored); `supabase start` reads it for config.toml.

# Google Sign-In (README, "Google Sign-In"): the web and iOS OAuth client IDs, comma-separated,
# so ID tokens from both are accepted.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# Only to try the send-email hook locally (config.toml, [auth.hook.send_email]): the same value
# as in supabase/functions/.env.
# SEND_EMAIL_HOOK_SECRET=
