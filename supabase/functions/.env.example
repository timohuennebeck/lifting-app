# Copy to supabase/functions/.env (git-ignored). In production, set them with
# `npx supabase secrets set --env-file supabase/functions/.env`.

# OpenAI API key. Which model each feature asks is set in _shared/models.ts.
OPENAI_API_KEY=sk-xxx

# Support message translations (README, "Translations"). The secret the database sends with its
# calls; the same value goes into the Vault as translation_webhook_secret. Locally,
# supabase/seed.sql puts this one there.
TRANSLATION_WEBHOOK_SECRET=local-translation-secret
# Optional: the team's language, which users' messages are translated into first (default de).
# SUPPORT_LANGUAGE=de

# Optional: limits of a file's plan (read-workout-file, step "plan"), per network and in total per
# 24 hours (README, "Workout import"). For `npm run plan:eval` locally raise the first: one run is
# one plan per test plan.
# PLAN_IMPORT_IP_LIMIT=10
# PLAN_IMPORT_DAILY_LIMIT=1000

# Optional: limits of the other steps of read-workout-file (what a file holds and which exercises
# it names), requests per network and in total per 24 hours (README, "Workout import"); one import
# takes about four.
# HISTORY_IMPORT_IP_LIMIT=40
# HISTORY_IMPORT_DAILY_LIMIT=4000

# Optional: voice input limits (exercises said out loud, read by read-exercises), per network
# and in total per 24 hours (README, "Voice input").
# PLAN_VOICE_IP_LIMIT=60
# PLAN_VOICE_DAILY_LIMIT=5000

# Optional: the same for the plan generation (README, "Plan generation"). For
# `npm run plan:generate-eval` locally raise the first: one run is 15 plans.
# PLAN_GENERATE_IP_LIMIT=10
# PLAN_GENERATE_DAILY_LIMIT=1000

# Optional: the coach (README, "Coach"). Questions per user in 24 hours and in 30 days.
# COACH_DAILY_LIMIT=20
# COACH_MONTHLY_LIMIT=150
# Speech to text for the coach's field: transcriptions per user and for everyone in 24 hours.
# COACH_TRANSCRIBE_USER_LIMIT=100
# COACH_TRANSCRIBE_DAILY_LIMIT=20000

# Sign in with Apple key, for revoking a user's Apple tokens when they delete their account
# (README, "Sign in with Apple"). The private key = the .p8 file's lines between BEGIN and END,
# joined into one line.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# The app ID the tokens belong to: Loqqa Dev's here (app.config.ts). Production leaves it out
# (app.loqqa.mobile is the default), so don't copy this line into production's secrets.
APPLE_CLIENT_ID=app.loqqa.mobile.dev

# RevenueCat secret API key (v1, sk_…). With it the progress check assessment, the coach and its
# voice input only run for accounts with an active Pro entitlement (README, "Purchases").
# Required in production: without it they log an error and refuse everyone. Optional locally,
# where everyone counts as Pro without it.
# REVENUECAT_SECRET_KEY=

# Auth emails (README, "Auth emails"): the send-email hook sends them through Resend. Only needed
# where the hook is on (production; locally only to try it): a Resend API key with sending access,
# the hook's secret from Authentication → Hooks (v1,whsec_…), optionally the sender.
# RESEND_API_KEY=
# SEND_EMAIL_HOOK_SECRET=
# EMAIL_FROM=Loqqa <no-reply@mail.useloqqa.com>
